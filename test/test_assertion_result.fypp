program test_assertion_result
  use mod_assertion_result, only: assertion_result, assertion_failure, test_result, &
                                  n_test, n_error, report_rank_error, report_rank_error_tap
  implicit none
  type(assertion_result) :: result, copied
  type(assertion_failure) :: failure
  type(test_result) :: no_results(0), errors(3), subtest_results(5), marker_only(1)
  integer :: i
  character(:), allocatable :: message, tap_message

  if (n_test(no_results) /= 0) error stop "n_test must handle an empty result list"
  if (n_error(no_results) /= 0) error stop "n_error must handle an empty result list"
  errors = [test_result(1, .true.), test_result(2, .false.), test_result(3, .true.)]
  if (n_test(errors) /= 3) error stop "n_test must return the latest test id"
  if (n_error(errors) /= 2) error stop "n_error must count errors in the current section"
  subtest_results = [test_result(1, .true.), test_result(2, .true.), &
                     test_result(0, .false.), test_result(1, .false.), test_result(2, .true.)]
  if (n_test(subtest_results) /= 2) error stop "n_test must reset at a section boundary"
  if (n_error(subtest_results) /= 1) error stop "n_error must ignore earlier sections"
  marker_only = [test_result(0, .false.)]
  if (n_error(marker_only) /= 0) error stop "n_error must handle an empty section"

  message = report_rank_error(3, [2, 3], [2, 4], "assert_equal")
  if (index(message, "assert_equal 3") == 0) error stop "rank report must include method and test number"
  if (index(message, "FAILED") == 0) error stop "rank report must mark the assertion as failed"
  if (index(message, "RankMissMatch: [2, 3] /= [2, 4]") == 0) &
    error stop "rank report must include both shapes"
  message = report_rank_error(12, [1], [2], "", "matrix shape")
  if (index(message, "matrix shape") == 0) error stop "rank report must use the supplied unit name"
  if (index(message, "RankMissMatch: [1] /= [2]") == 0) error stop "rank report must format rank-one shapes"

  tap_message = report_rank_error_tap(3, 0, [2, 3], [2, 4], "assert_equal", "matrix shape")
  if (index(tap_message, "not ok 3 # matrix shape") == 0) &
    error stop "TAP rank report must emit a not-ok result"
  if (index(tap_message, "assertion: assert_equal") == 0) error stop "TAP rank report must include the assertion"
  if (index(tap_message, "rank: false") == 0) error stop "TAP rank report must mark rank mismatch"
  if (index(tap_message, "shape_a:") == 0 .or. index(tap_message, "shape_b:") == 0) &
    error stop "TAP rank report must include both shapes"

  if (result%size() /= 0) error stop "new result must be empty"

  result%method = "assert_equal"
  result%shape_a = [2, 3]
  result%shape_b = [2, 3]
  do i = 1, 17
    call result%push(i, "failure detail")
  end do

  if (result%size() /= 17) error stop "push must increase the logical size"
  failure = result%get_detail(1)
  if (failure%flat_idx /= 1) error stop "first flat index was not retained"
  if (trim(failure%detail) /= "failure detail") error stop "first detail was not retained"
  failure = result%get_detail(17)
  if (failure%flat_idx /= 17) error stop "last flat index was not retained"
  if (trim(failure%detail) /= "failure detail") error stop "last detail was not retained"
  if (trim(result%method) /= "assert_equal") error stop "method was not retained"
  if (any(result%shape_a /= [2, 3])) error stop "shape_a was not retained"
  if (any(result%shape_b /= [2, 3])) error stop "shape_b was not retained"

  copied = result
  call result%push(18, "after copy")
  if (copied%size() /= 17) error stop "copy changed after original was extended"
  if (result%size() /= 18) error stop "push after copy failed"

  call result%clear()
  if (result%size() /= 0) error stop "clear must reset the logical size"
  if (allocated(result%shape_a)) error stop "clear must release shape_a"
  if (allocated(result%shape_b)) error stop "clear must release shape_b"
end program test_assertion_result
