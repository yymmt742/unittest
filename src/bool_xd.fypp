#:include "common.fypp"
submodule(mod_unittest) bool_xd
  implicit none
contains
#:include "report_functions.fypp"
  module procedure unittest_assert_xd_logical
    integer :: i, n
    logical :: err
    type(assertion_result) :: result
    n = PRODUCT(shape_expr)
    err = .not.ALL(expr(1:n))
    if (PRESENT(is_failed)) is_failed = err
    result%method = "assert_xd"
    result%shape_a = shape_expr
    if (err) then
      do i = 1, n
        if (.not.expr(i)) then
          call result%push(i, "logical value is false")
        end if
      end do
    end if
    call this%apend_result(result, unitname=unitname)
    call this%report_result(result, unitname, &
      show_details=this%verbose > 0 .and. n < this%dump_line_limit)
    call result%destroy()
  end procedure unittest_assert_xd_logical
include "result_functions.f90"
include "image_functions.f90"
end submodule bool_xd
