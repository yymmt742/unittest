#:include "common.fypp"
submodule(mod_unittest) allclose_xd
  implicit none
contains
#:include "report_functions.fypp"
#:for kind, type, post in [x for x in REAL_KIND_TYPE_POSTS + COMPLEX_KIND_TYPE_POSTS if x[0] in ["sp", "dp"]]
#:for routine, invert in [("allclose", True), ("not_allclose", False)]
  module procedure ${"unittest_assert_" + routine + "_xd_" + post}$
    integer :: i, n
    real(${kind}$) :: abs_tol, rel_tol, scale, delta
    logical :: err
    type(assertion_result) :: result
    if (SIZE(shape_a) /= SIZE(shape_b)) then
      err = .true.
    else
      err = ANY(shape_a /= shape_b)
    end if
    if (PRESENT(is_failed)) is_failed = err
      if (err) then
      result%method = "${routine + '_xd'}$"
      result%shape_a = shape_a
      result%shape_b = shape_b
      call this%push(result)
      call result%report_result(this%dev, result%id, this%nest, this%tap_support, unitname)
      call result%destroy()
      return
    end if
    n = PRODUCT(shape_a)
    result%method = "${routine + '_xd'}$"
    result%shape_a = shape_a
    result%shape_b = shape_b
    abs_tol = 1E-8_${kind}$
    rel_tol = 1E-5_${kind}$
    if (PRESENT(atol)) abs_tol = MAX(atol, 0.0_${kind}$)
    if (PRESENT(rtol)) rel_tol = MAX(rtol, 0.0_${kind}$)
    scale = 0.0_${kind}$
    do i = 1, n
      scale = MAX(scale, REAL(ABS(a(i)), ${kind}$), REAL(ABS(b(i)), ${kind}$))
    end do
    err = ${".false." if invert else ".true."}$
    do i = 1, n
      delta = REAL(ABS(a(i) - b(i)), ${kind}$)
      if (delta >= abs_tol + rel_tol * scale) then
#:if invert
        err = .true.
        call result%push(i, "values differ beyond allclose tolerance")
#:else
        err = .false.
        exit
#:endif
      end if
    end do
#:if not invert
    if (err) &
      call result%push(0, "all elements are within tolerance")
#:endif
    if (PRESENT(is_failed)) is_failed = err
    call this%push(result)
    call result%report_result(this%dev, result%id, &
      this%nest, this%tap_support, unitname, &
      show_details=this%verbose > 0 .and. n < this%dump_line_limit)
    call result%destroy()
  end procedure ${"unittest_assert_" + routine + "_xd_" + post}$
#:endfor
#:endfor
include "result_functions.f90"
include "image_functions.f90"
end submodule allclose_xd
